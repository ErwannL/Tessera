# Tessera configuration. `make up` copies this file to .env and replaces every
# CHANGE_ME value with a generated secret. Never commit .env.
# See docs/CONFIGURATION.md for every variable, its default and its bounds.

# --- Required ---------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# postgres://user:password@host:port/database
DATABASE_URL=postgres://tessera:CHANGE_ME_postgres_password@postgres:5432/tessera
# Comma-separated API keys (>= 32 random characters each). Several keys allow rotation.
API_KEYS=CHANGE_ME_api_key_at_least_32_random_characters
# HMAC key for stored codes (>= 32 characters, distinct from every other secret).
CODE_HMAC_KEY=CHANGE_ME_code_hmac_key_32_random_characters
# Shared with the App server, which signs the dashboard handoff tokens (HS256).
HANDOFF_SECRET=CHANGE_ME_handoff_secret_32_random_characters
# Signs the dashboard session cookie.
SESSION_SECRET=CHANGE_ME_session_secret_32_random_characters
# Public origin of Tessera, as seen by browsers.
PUBLIC_URL=http://localhost:3000
# false, true, or a comma-separated list of trusted proxy IPs/CIDRs.
TRUST_PROXY=false

# --- Optional (defaults shown) ----------------------------------------------
PORT=3000
HOST=0.0.0.0
CODE_LENGTH=6
DEFAULT_EXPIRES_IN_SECONDS=600
MIN_EXPIRES_IN_SECONDS=60
MAX_EXPIRES_IN_SECONDS=86400
DEFAULT_MAX_ATTEMPTS=5
SESSION_TTL_SECONDS=3600
RETENTION_DAYS=365
EXPIRY_SWEEP_INTERVAL_SECONDS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=600
RATE_LIMIT_VERIFY_IP_MAX=30
RATE_LIMIT_VERIFY_REQUEST_MAX=10
RATE_LIMIT_HANDOFF_IP_MAX=10
LOG_LEVEL=info

# --- Development stack only (docker-compose.yml) ----------------------------
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# The demo App uses one of API_KEYS (make up sets it to the generated key).
DEMO_API_KEY=CHANGE_ME_api_key_at_least_32_random_characters

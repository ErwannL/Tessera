{
  "name": "tessera",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "examples/demo-app",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "sh scripts/up.sh",
    "up:demo": "sh scripts/up.sh --profile demo",
    "down": "docker compose --profile demo down",
    "logs": "docker compose --profile demo logs -f",
    "test": "sh scripts/in-docker.sh npm run test:all",
    "coverage": "sh scripts/in-docker.sh npm run coverage:all",
    "lint": "sh scripts/in-docker.sh npm run lint:all",
    "e2e": "sh scripts/e2e.sh",
    "build": "docker build --target runtime -t tessera:latest .",
    "test:all": "npm run test -w backend && npm run test -w frontend",
    "coverage:all": "npm run coverage -w backend && npm run coverage -w frontend",
    "lint:all": "eslint . --max-warnings=0 && prettier --check . && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
